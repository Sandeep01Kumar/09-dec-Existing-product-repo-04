# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env and configure values
# for your environment. Do not commit .env file.
# ============================================

# ============================================
# Server Configuration
# ============================================
# HTTP server port (default: 3000)
PORT=3000

# HTTPS server port (default: 3443)
HTTPS_PORT=3443

# Enable/disable HTTPS server (default: false)
# Set to 'true' to enable HTTPS support
HTTPS_ENABLED=false

# Application environment (development, staging, production)
NODE_ENV=development

# ============================================
# Security Configuration
# ============================================
# Allowed CORS origins (comma-separated for multiple origins)
# Use '*' for development only - restrict in production
CORS_ORIGIN=http://localhost:3000

# Rate limiting window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per rate limit window (default: 100)
RATE_LIMIT_MAX=100

# ============================================
# SSL Certificate Paths
# ============================================
# Path to SSL private key file
# Generate with: npm run generate-certs
SSL_KEY_PATH=./certs/key.pem

# Path to SSL certificate file
# Generate with: npm run generate-certs
SSL_CERT_PATH=./certs/cert.pem
